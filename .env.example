VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Public web deployment origin (no trailing slash). Used for shareable links
# and auth email redirects inside the native apps, whose WebView origin is
# localhost. Optional on web — the current origin is the default.
# VITE_PUBLIC_WEB_ORIGIN=https://your-campus-deployment.example.com

# Web push (VAPID) public key — browser/PWA only, not used by native apps.
# VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY

# "Get the native app" prompt for mobile browsers (src/lib/appDownload.ts).
# Android is ACTIVE by default: it links to the signed APK on GitHub Releases
# (https://github.com/sarthakmulik/CAMPUS/releases/latest/download/CAMPUS.apk).
# Set VITE_ANDROID_APP_URL to override that (e.g. the Play Store once listed).
# iOS has NO default — set VITE_IOS_APP_URL to the live App Store https link to
# activate it. Desktop browsers are never prompted regardless. https only.
# VITE_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.campus.app
# VITE_IOS_APP_URL=https://apps.apple.com/app/idYOUR_APP_STORE_ID
