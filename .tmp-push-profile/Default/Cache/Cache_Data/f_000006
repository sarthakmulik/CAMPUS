px; color: #5a6b83; padding: 26px 18px;\n}\n.nc-state svg { color: #b9c0d5; }\n.nc-state b { font-size: 14px; color: #1b3157; }\n.nc-state span { font-size: 12px; line-height: 1.55; max-width: 330px; }\n\n/* suggestions — deliberately a separate card, NOT notification rows */\n.nc-suggestions {\n  margin: 22px 12px 0; padding: 14px; border: 1px solid #eee8f6;\n  border-radius: 16px; background: #fffdfb;\n}\n.nc-suggestions h2 {\n  margin: 0 0 10px; font-size: 12px; letter-spacing: .3px; text-transform: uppercase;\n  color: #6b5af0; display: flex; align-items: center; gap: 7px;\n}\n.nc-sugg-status { margin: 4px 0 8px; font-size: 11.5px; color: #5a6b83; display: flex; align-items: center; gap: 7px; }\n.nc-sugg-row {\n  display: flex; align-items: center; justify-content: space-between; gap: 10px;\n  padding: 8px 0; border-bottom: 1px solid #f6f2f8;\n}\n.nc-sugg-row:last-child { border-bottom: 0; }\n.nc-sugg-person { display: flex; align-items: center; gap: 10px; border: 0; background: transparent; padding: 0; text-align: left; min-width: 0; flex: 1; cursor: pointer; }\n.nc-sugg-copy { min-width: 0; display: flex; flex-direction: column; }\n.nc-sugg-copy b { font-size: 12.5px; color: #1b3157; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.nc-sugg-copy small { font-size: 10.5px; color: #8a95a8; }\n.nc-follow { height: 30px; font-size: 11px; padding: 0 13px; border-radius: 15px; flex-shrink: 0; }\n.nc-follow.on { background: #eef1f6; color: #5a6b83; }\n\n/* settings sheet */\n.nc-settings { max-height: 86vh; }\n.nc-settings-scroll { overflow-y: auto; padding: 0 16px 16px; }\n.nc-settings .settings-card { margin-top: 12px; }\n.nc-settings .settings-hint { margin: 7px 0 2px; display: flex; align-items: flex-start; gap: 6px; }\n.nc-cat-head {\n  display: grid; grid-template-columns: 1fr 52px 52px; gap: 8px;\n  margin: 10px 0 2px; font-size: 9.5px; text-transform: uppercase; letter-spacing: .4px; color: #8a95a8;\n}\n.nc-cat-head span:nth-child(2), .nc-cat-head span:last-child { text-align: center; }\n.nc-cat-row { display: grid; grid-template-columns: 1fr 52px 52px; gap: 8px; align-items: center; padding: 8px 0; border-bottom: 1px solid #f4f0f2; }\n.nc-cat-row:last-child { border-bottom: 0; }\n.nc-cat-row > div:first-child { min-width: 0; }\n.nc-cat-row b { font-size: 12px; color: #24355b; }\n.nc-devices { margin-top: 10px; padding-top: 10px; border-top: 1px dashed #eae5ef; }\n.nc-devices-title { display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; color: #31456a; }\n.nc-device-row { display: flex; align-items: center; justify-content: space-between; padding: 5px 0; font-size: 11.5px; color: #5a6b83; }\n.nc-quiet-times { display: flex; gap: 10px; margin-top: 10px; }\n.nc-quiet-times label { display: flex; flex-direction: column; gap: 4px; font-size: 10.5px; color: #5a6b83; }\n.nc-quiet-times input {\n  border: 1px solid #e6ebf2; border-radius: 9px; padding: 7px 9px; font-size: 12px; background: #fff; color: #1b3157;\n}\n.nc-tz-row { display: flex; flex-direction: column; gap: 4px; margin-top: 8px; font-size: 10.5px; color: #5a6b83; }\n.nc-tz-row input {\n  border: 1px solid #e6ebf2; border-radius: 9px; padding: 7px 9px; font-size: 12px; background: #fff; color: #1b3157;\n}\n.nc-dead-zone { color: #8a95a8; }\n\n.spin { animation: nc-spin 1s linear infinite; }\n@keyframes nc-spin { to { transform: rotate(360deg); } }\n\n@media (max-width: 650px) {\n  .nc-head { padding: 12px 12px 6px; }\n  .nc-head-title .page-title { font-size: 18.5px; }\n  .nc-tabs { margin: 4px 12px 9px; }\n  .nc-list { padding: 0 6px; }\n  .nc-row { padding: 10px 7px; gap: 9px; }\n  .nc-avatar, .nc-avatar .avatar, .nc-avatar img { width: 40px; height: 40px; }\n  .nc-row-thumb { width: 40px; height: 40px; }\n  .nc-push-prompt { margin: 4px 12px 7px; }\n  .nc-suggestions { margin: 18px 8px 0; }\n}\n\n"
