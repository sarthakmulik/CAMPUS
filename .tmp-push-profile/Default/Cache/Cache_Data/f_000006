static * { animation: none !important; }\n.boot-static .boot-blob, .boot-static .boot-logo, .boot-static .boot-halo,\n.boot-static .boot-net, .boot-static .boot-node { opacity: 1 }\n\n/* exit — the veil carries the whole loader out while the app is already\n   rendered beneath it, so there is no blank frame */\n.boot-veil {\n  position: fixed;\n  inset: 0;\n  z-index: 90;\n  pointer-events: none;\n  animation: boot-out .5s cubic-bezier(.4, 0, .2, 1) .04s forwards;\n}\n.boot-veil .boot-screen { position: absolute; inset: 0; min-height: 100vh; }\n@keyframes boot-out { to { opacity: 0 } }\n\n/* mobile: tighten, keep clear of the safe areas, no overflow */\n@media (max-width: 650px) {\n  .boot-screen { padding: 28px 18px; }\n  .boot-logo { width: 60px; height: 60px; border-radius: 19px; }\n  .boot-logo-lockup { font-size: 32px; }\n  .boot-halo { width: 126px; height: 126px; }\n  .boot-net { width: 196px; height: 54px; }\n  .boot-blob { filter: blur(56px); }\n}\n\n/* reduced motion: static composition, halos and drifts frozen; the hairline\n   keeps only a gentle opacity pulse so progress is still signalled */\n@media (prefers-reduced-motion: reduce) {\n  .boot-screen *, .boot-screen { animation-duration: .01s !important; animation-iteration-count: 1 !important; transition: none !important; }\n  .boot-bar i { animation: boot-reduced-pulse 1.6s ease-in-out infinite alternate !important; transform: none !important; width: 100% !important; opacity: .4 !important; }\n  @keyframes boot-reduced-pulse { from { opacity: .25 } to { opacity: .55 } }\n}\n\n.field-label {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n  margin: 0 0 14px;\n  font-size: 12px;\n  font-weight: 650;\n  color: #475569;\n}\n.field-label input,\n.field-label select,\n.field-label textarea {\n  width: 100%;\n  padding: 12px 13px;\n  border: 1px solid #dfe1ee;\n  border-radius: 11px;\n  background: #fff;\n  color: #17284c;\n  font-size: 14px;\n  outline: none;\n  transition: border-color .16s, box-shadow .16s;\n}\n.field-label textarea { resize: vertical; line-height: 1.55 }\n.field-label input:focus,\n.field-label select:focus,\n.field-label textarea:focus { border-color: #6654f5; box-shadow: 0 0 0 3px #6654f526 }\n.optional { font-weight: 500; font-size: 11px; color: #5a6b83 }\n\n.input-with-action {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding-left: 12px;\n  border: 1px solid #dfe1ee;\n  border-radius: 11px;\n  background: #fff;\n  color: #5a6b83;\n  transition: border-color .16s, box-shadow .16s;\n}\n.input-with-action:focus-within { border-color: #6654f5; box-shadow: 0 0 0 3px #6654f526 }\n.input-with-action input {\n  flex: 1;\n  min-width: 0;\n  padding: 12px 100px 12px 0;\n  border: 0;\n  border-radius: 0;\n  background: transparent;\n  box-shadow: none !important;\n  font-size: 14px;\n  color: #17284c;\n}\n.input-with-action:has(.input-action) input { padding-right: 46px }\n.input-action { position: absolute; right: 4px; top: 50%; transform: translateY(-50%) }\n.username-status {\n  position: absolute;\n  right: 11px;\n  font-size: 11px;\n  font-weight: 700;\n  padding: 3px 9px;\n  border-radius: 20px;\n  white-space: nowrap;\n}\n.username-status.checking { background: #eef1f7; color: #42526e }\n.username-status.available { background: #e4f7ec; color: #0b6b41 }\n.username-status.taken, .username-status.invalid { background: #ffe9ec; color: #a41d29 }\n\n.field-hint { font-size: 12px; color: #5a6b83; line-height: 1.55; margin: 6px 0 0 }\n.field-hint.success { color: #0b6b41 }\n.field-hint.centered {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  text-align: center;\n  margin-top: 14px;\n}\n.form-error {\n  display: flex;\n  align-items: flex-start;\n  gap: 7px;\n  margin: 0 0 14px;\n  padding: 10px 13px;\n  border: 1px solid #ffd2d8;\n  border-radius: 11px;\n  background: #fff2f3;\n  color: #a41d29;\n  font-size: 12.5px;\n  font-weight: 600;\n  line-height: 1.5;\n}\n.fo