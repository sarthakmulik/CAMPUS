ent: space-between;\n  gap: 10px;\n  padding-top: 6px;\n  border-top: 1px solid rgba(43, 38, 96, 0.08);\n}\n\n.inline-composer-buttons { display: inline-flex; align-items: center; gap: 8px; }\n\n.inline-cancel {\n  border: none;\n  background: none;\n  color: rgba(43, 38, 96, 0.6);\n  font: inherit;\n  font-size: 13.5px;\n  cursor: pointer;\n  padding: 6px 8px;\n}\n\n/* ---- Attachments --------------------------------------------------------- */\n\n.sheet-media-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 4px 2px 8px;\n}\n\n.attach-button {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  padding: 7px 14px;\n  border-radius: 999px;\n  border: 1.5px dashed rgba(102, 84, 245, 0.55);\n  color: #4a3fd0;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.attach-button:hover { background: rgba(102, 84, 245, 0.08); }\n\n.attach-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 5px 8px 5px 12px;\n  border-radius: 999px;\n  background: rgba(102, 84, 245, 0.1);\n  color: #4a3fd0;\n  font-size: 12.5px;\n  max-width: 260px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.attach-chip .icon-button.small { padding: 3px; }\n\n.post-media-row {\n  margin-top: 10px;\n  display: grid;\n  gap: 8px;\n}\n\n.post-media {\n  width: 100%;\n  max-height: 420px;\n  object-fit: cover;\n  border-radius: 14px;\n  border: 1px solid rgba(43, 38, 96, 0.12);\n  display: block;\n}\n\n/* ---- Image carousel (Instagram-inspired) --------------------------------- */\n\n.carousel {\n  position: relative;\n  margin-top: 10px;\n  border-radius: 14px;\n  overflow: hidden;\n}\n\n.carousel-track {\n  display: flex;\n  overflow-x: auto;\n  scroll-snap-type: x mandatory;\n  scrollbar-width: none;\n  border-radius: 14px;\n}\n\n.carousel-track::-webkit-scrollbar { display: none; }\n\n.carousel-track img {\n  flex: 0 0 100%;\n  scroll-snap-align: center;\n  width: 100%;\n  aspect-ratio: 1 / 1;\n  object-fit: cover;\n  background: #efece2;\n  user-select: none;\n}\n\n.carousel-dots {\n  position: absolute;\n  bottom: 10px;\n  left: 0;\n  right: 0;\n  display: flex;\n  justify-content: center;\n  gap: 6px;\n  pointer-events: none;\n}\n\n.carousel-dots button {\n  pointer-events: auto;\n  width: 7px;\n  height: 7px;\n  padding: 0;\n  border-radius: 50%;\n  border: none;\n  background: rgba(255, 255, 255, 0.45);\n}\n\n.carousel-dots button.on { background: #fff; }\n\n.carousel-arrow {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  border: none;\n  background: rgba(20, 16, 40, 0.55);\n  color: #fff;\n  font-size: 20px;\n  line-height: 1;\n  display: grid;\n  place-items: center;\n  cursor: pointer;\n}\n\n.carousel-arrow:disabled { opacity: 0; cursor: default; }\n.carousel-arrow.left { left: 8px; }\n.carousel-arrow.right { right: 8px; }\n\n.carousel-picker {\n  width: 100%;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-bottom: 8px;\n}\n\n.picker-thumb {\n  position: relative;\n  width: 62px;\n  height: 62px;\n  border-radius: 12px;\n  overflow: hidden;\n  border: 1.5px solid rgba(102, 84, 245, 0.5);\n  padding: 0;\n  cursor: pointer;\n  background: none;\n}\n\n.picker-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }\n\n.picker-thumb svg {\n  position: absolute;\n  inset: 0;\n  margin: auto;\n  color: #fff;\n  filter: drop-shadow(0 1px 2px rgba(0,0,0,0.6));\n  opacity: 0;\n  transition: opacity 0.15s;\n}\n\n.picker-thumb:hover svg { opacity: 1; }\n\n.media-hint { font-size: 12px; margin: 2px 0; opacity: 0.8; }\n\n.media-hint b { color: #4a3fd0; }\n\n.picker-thumb-more {\n  display: grid;\n  place-items: center;\n  border-style: dashed;\n  color: #4a3fd0;\n  background: rgba(102, 84, 245, 0.06);\n}\n\n.picker-thumb-more span { display: grid; place-items: center; }\n\n.carousel-hint, .reel-ready span, .trim-hint {\n  font-size: 12.5px;\n  opacity: 0.75;\n}\n\n/* ---- Reel picker + trim modal -------------------------------------------- */\n\n.reel-picker { flex-direction: column; align-items: flex-start; }\n\n.reel-ready {\n  width: 100%;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 6px 10px;\n  padding: 10px 12px;\n  border-radius: 12px;\n  border: 1px solid rgba(102, 84, 245, 0.35);\n  background: rgba(102, 84, 245, 0.06);\n}\n\n.reel-ready b { font-size: 13.5px; }\n\n.reel-ready-actions { display: inline-flex; gap: 8px; margin-left: auto; }\n\n.attach-button.ghost { border-color: rgba(43, 38, 96, 0.25); color: rgba(43, 38, 96, 0.75); }\n\n.attach-button.trim-needed { border-style: solid; border-color: rgba(178, 34, 52, 0.6); color: #a11427; }\n\n.media-progress { font-size: 12.5px; color: #4a3fd0; font-weight: 600; }\n\n.trim-overlay { z-index: 60; }\n\n.trim-sheet { max-width: 640px; }\n\n.trim-video-wrap {\n  position: relative;\n  border-radius: 14px;\n  overflow: hidden;\n  background: #14101f;\n  margin: 4px 0 12px;\n}\n\n.trim-video { width: 100%; max-height: 300px; object-fit: contain; display: block; }\n\n.trim-play {\n  position: absolute;\n  left: 12px;\n  bottom: 12px;\n  width: 42px;\n  height: 42px;\n  border-radius: 50%;\n  border: none;\n  background: rgba(20, 16, 40, 0.65);\n  color: #fff;\n  display: grid;\n  place-items: center;\n  cursor: pointer;\n}\n\n.trim-meta {\n  display: flex;\n  justify-content: space-between;\n  gap: 10px;\n  font-size: 13.5px;\n  margin-bottom: 8px;\n}\n\n.form-error-inline { color: #a11427; font-weight: 600; }\n\n.trim-track {\n  position: relative;\n  height: 14px;\n  border-radius: 999px;\n  background: rgba(102, 84, 245, 0.15);\n  margin-bottom: 2px;\n}\n\n.trim-fill {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  border-radius: 999px;\n  background: #6654F5;\n}\n\n.trim-ranges { position: relative; height: 34px; }\n\n.trim-ranges input[type=range] {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  margin: 0;\n  background: none;\n  pointer-events: none;\n  -webkit-appearance: none;\n}\n\n.trim-ranges input[type=range]::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  pointer-events: auto;\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  background: #fff;\n  border: 3px solid #6654F5;\n  cursor: grab;\n  box-shadow: 0 1px 4px rgba(0,0,0,0.3);\n}\n\n.trim-ranges input[type=range]::-moz-range-thumb {\n  pointer-events: auto;\n  width: 14px;\n  height: 14px;\n  border-radius: 50%;\n  background: #fff;\n  border: 3px solid #6654F5;\n  cursor: grab;\n}\n\n.trim-times {\n  display: flex;\n  justify-content: space-between;\n  font-size: 12px;\n  opacity: 0.7;\n  margin: 2px 2px 10px;\n}\n\n.trim-hint { display: flex; align-items: center; gap: 6px; margin: 10px 0 0; }\n\n/* ---- Post CRUD ------------------------------------------------------------- */\n\n.edited-marker {\n  font-style: italic;\n  opacity: 0.65;\n  font-size: 12.5px;\n}\n\n.post-menu button.danger { color: #a11427; }\n\n.confirm-sheet { padding-bottom: 20px; }\n\n.confirm-copy {\n  font-size: 14.5px;\n  border-left: 3px solid rgba(102, 84, 245, 0.45);\n  padding: 6px 12px;\n  margin: 4px 0 10px;\n  color: rgba(43, 38, 96, 0.85);\n}\n\n.danger-button {\n  background: #a11427;\n}\n\n/* ---- Feed card polish (media posts: caption under actions) ------------------ */\n\n/* Caption sits under the like/comment row with tight, clean rhythm */\n.post-caption {\n  margin: 0;\n  padding: 3px 2px 5px;\n  font-size: 13px;\n  line-height: 1.55;\n  color: #2d4268;\n  overflow-wrap: anywhere;\n}\n\n/* Action row: comfortable pill buttons instead of cramped icons */\n.post-actions {\n  gap: 3px;\n  margin-top: 2px;\n  align-items: center;\n}\n\n.post-actions button {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 7px 12px;\n  border-radius: 999px;\n  border: none;\n  background: transparent;\n  font-weight: 600;\n  color: #54688a;\n  transition: background 0.15s ease, color 0.15s ease;\n}\n\n.post-actions button:hover { background: #f5f3ff; color: #4331c9; }\n.post-actions button:first-child:not(.liked):hover { background: #ffeef2; color: #d12b5e; }\n.post-actions button.liked { background: #ffeef2; }\n.post-actions button.reposted:hover { background: #eef6ff; color: #1d8ad1; }\n\n.action-spacer { flex: 1; height: 1px; }\n\n/* Right-side bookmark / flag: round quiet buttons */\n.post-actions button:has(svg:only-child) {\n  width: 34px;\n  height: 34px;\n  padding: 0;\n  border-radius: 50%;\n  justify-content: center;\n}\n\n.post-actions button.saved { color: #b98a00; }\n\n/* Media blocks stay flush with the card's own gap spacing */\n.carousel,\n.post-media-row {\n  margin-top: 0;\n}\n\n.post-media {\n  margin-top: 0;\n}\n\n.reel-player { margin-top: 0; }\n\n@media (max-width: 650px) {\n  .post-caption { font-size: 12.5px; padding: 3px 1px 4px; }\n  .post-card { gap: 9px; }\n  .post-actions { gap: 1px; }\n  .post-actions button { padding: 7px 9px; font-size: 11px; gap: 5px; }\n  .post-actions button svg { width: 17px !important; height: 17px !important; }\n  .post-actions button:has(svg:only-child) { width: 32px; height: 32px; }\n  .post-body { margin: 0; }\n}\n\n/* ---- Reel player ----------------------------------------------------------- */\n\n.reel-player {\n  position: relative;\n  border-radius: 14px;\n  overflow: hidden;\n  background: #100c1f;\n  cursor: pointer;\n}\n\n.reel-player .reel-video {\n  width: 100%;\n  max-height: 470px;\n  object-fit: cover;\n  display: block;\n}\n\n.reel-big-play {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  width: 58px;\n  height: 58px;\n  border-radius: 50%;\n  background: rgba(102, 84, 245, 0.88);\n  color: #fff;\n  display: grid;\n  place-items: center;\n  box-shadow: 0 10px 28px rgba(20, 10, 50, 0.45);\n  padding-left: 4px;\n  pointer-events: none;\n  animation: reel-pop 0.18s ease;\n}\n\n@keyframes reel-pop {\n  from { transform: translate(-50%, -50%) scale(0.7); opacity: 0; }\n  to { transform: translate(-50%, -50%) scale(1); opacity: 1; }\n}\n\n.reel-bar {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 22px 12px 10px;\n  background: linear-gradient(180deg, rgba(12, 9, 24, 0) 0%, rgba(12, 9, 24, 0.78) 55%, rgba(12, 9, 24, 0.9) 100%);\n  color: #fff;\n}\n\n.reel-bar-button {\n  background: rgba(255, 255, 255, 0.14);\n  border: none;\n  color: #fff;\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n  display: grid;\n  place-items: center;\n  cursor: pointer;\n  flex: 0 0 auto;\n}\n\n.reel-bar-button:hover { background: rgba(255, 255, 255, 0.24); }\n\n.reel-progress {\n  flex: 1;\n  height: 18px;\n  display: flex;\n  align-items: center;\n  cursor: pointer;\n}\n\n.reel-track {\n  display: block;\n  position: relative;\n  width: 100%;\n  height: 4px;\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.24);\n  overflow: hidden;\n}\n\n.reel-track i {\n  position: absolute;\n  inset: 0 auto 0 0;\n  border-radius: 999px;\n  background: linear-gradient(90deg, #8b7cff, #6654F5);\n}\n\n.reel-time {\n  font-size: 11.5px;\n  font-variant-numeric: tabular-nums;\n  opacity: 0.9;\n  white-space: nowrap;\n}\n\n/* ---- Right panel real data + system info pages ------------------------------- */\n\n.panel-hint {\n  font-size: 12.5px;\n  color: #5a6b83;\n  line-height: 1.55;\n  padding: 4px 2px 2px;\n}\n\n.footer-links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 2px 4px;\n  margin-bottom: 6px;\n}\n\n.footer-links button {\n  border: 0;\n  background: transparent;\n  color: #4a5fc4;\n  font-size: 12px;\n  font-weight: 600;\n  padding: 3px 7px;\n  border-radius: 9px;\n  transition: background 0.15s, color 0.15s;\n}\n\n.footer-links button:hover {\n  background: #eff3ff;\n}\n\n.footer-links button + button::before {\n  content: none;\n}\n\n/* --- info pages --- */\n\n.info-page {\n  gap: 4px;\n}\n\n.info-intro {\n  font-size: 14px;\n  font-weight: 600;\n  color: #2d4268;\n}\n\n.info-block {\n  text-align: left;\n  background: #fff;\n  border: 1px solid #eef1f6;\n  border-radius: 15px;\n  padding: 14px 16px;\n  margin-top: 10px;\n  box-shadow: 0 4px 15px #2e355d06;\n}\n\n.info-block h3 {\n  margin: 0 0 8px;\n  font-size: 14.5px;\n  color: #1b3157;\n}\n\n.info-block p {\n  margin: 0 0 8px;\n  font-size: 13px;\n  line-height: 1.7;\n  color: #2d4268;\n}\n\n.info-block p:last-child,\n.info-block ul:last-child {\n  margin-bottom: 0;\n}\n\n.info-list {\n  margin: 0;\n  padding-left: 20px;\n  display: grid;\n  gap: 7px;\n}\n\n.info-list li {\n  font-size: 13px;\n  line-height: 1.6;\n  color: #2d4268;\n}\n\n@media (max-width: 650px) {\n  .info-block {\n    padding: 12px 13px;\n  }\n}\n\n.drawer-footer {\n  margin-top: 14px;\n  padding-top: 12px;\n  border-top: 1px solid var(--line);\n  display: flex;\n  flex-wrap: wrap;\n  gap: 2px 6px;\n}\n\n.drawer-footer button {\n  border: 0;\n  background: transparent;\n  color: #5a6b83;\n  font-size: 12px;\n  font-weight: 600;\n  padding: 5px 8px;\n  border-radius: 9px;\n}\n\n.drawer-footer button:hover {\n  color: #4a5fc4;\n  background: #eff3ff;\n}\n\n@media (min-width: 651px) {\n  .drawer-footer {\n    display: none;\n  }\n}\n\n/* ---- Mobile swipe navigation + sliding nav drawer (≤650px) ------------------- */\n\n@media (max-width: 650px) {\n  .mobile-header-left {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n\n  /* Root scroll lock: pages scroll inside .main-column and the window itself\n     never scrolls. Chrome's auto-hiding toolbar drives the layout viewport\n     height — a fixed bottom nav follows it, which read as the footer sliding\n     in/out of the bottom edge. With nothing scrollable at the root the\n     toolbar (and the footer) stay perfectly still no matter how fast pages\n     are switched. */\n  .app-shell {\n    height: 100vh;\n    height: 100dvh;\n    min-height: 0;\n    box-sizing: border-box;\n    padding-top: 50px;\n    padding-bottom: 59px;\n    overflow: hidden;\n  }\n\n  .main-column {\n    height: 100%;\n    min-height: 0;\n    overflow-y: auto;\n    -webkit-overflow-scrolling: touch;\n    overscroll-behavior-y: contain;\n    scrollbar-width: none;\n  }\n\n  .main-column::-webkit-scrollbar {\n    display: none;\n  }\n\n  /* own compositing layer — protects the blurred bar from the sibling\n     transform animations, which could otherwise drop its paint */\n  .mobile-bottom-nav {\n    transform: translateZ(0);\n  }\n\n  /* ---- immersive direct conversation ------------------------------------- */\n  /* The thread screen unmounts the global bottom nav; the viewport it frees\n     must flow into the message timeline, and the composer picks up the\n     device safe-area inset the nav used to occupy. */\n  .app-shell.nav-hidden { padding-bottom: 0; }\n  .app-shell.nav-hidden .chat-compose {\n    padding-bottom: calc(10px + env(safe-area-inset-bottom));\n  }\n\n  /* ---- compact community chrome ------------------------------------------ */\n  /* the compact topbar and the tab row stick inside the page scroller; the\n     content starts immediately beneath them, nothing covers the first item */\n  .detail-topbar {\n    position: sticky;\n    top: 0;\n    z-index: 30;\n    background: #fffdfbf0;\n    backdrop-filter: blur(10px);\n    -webkit-backdrop-filter: blur(10px);\n    margin: 0 0 6px;\n    padding: 9px 0 5px;\n  }\n  .community-detail > .community-tabs.detail-tabs {\n    position: sticky;\n    top: 47px;\n    z-index: 29;\n    background: #fffdfbf0;\n    backdrop-filter: blur(10px);\n    -webkit-backdrop-filter: blur(10px);\n    margin: 0 0 10px;\n    padding: 3px 0 0;\n    border-bottom: 1px solid #eef0f7;\n  }\n  /* sticky pair never overlaps the first item: no extra top padding */\n  .community-detail { padding-top: 8px; }\n\n  /* sticky bars now reference the inner container, which already starts\n     below the fixed 50px header */\n  .feed-tabs {\n    top: 0;\n  }\n\n  /* the nav drawer lives off-canvas and slides in/out */\n  .left-sidebar {\n    display: flex;\n    position: fixed;\n    inset: 50px 0 60px;\n    width: 100%;\n    height: auto;\n    /* start the list below the absolute ✕ close button */\n    padding: 52px 14px 14px;\n    background: white;\n    border: 0;\n    z-index: 38;\n    transform: translateX(-105%);\n    visibility: hidden;\n    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1), visibility 0s linear 0.3s;\n  }\n\n  /* the CAMPUS brand lives in the fixed header above the drawer — no repeat */\n  .left-sidebar .brand {\n    display: none;\n  }\n\n  .left-sidebar.mobile-open {\n    transform: none;\n    visibility: visible;\n    /* styles.css sets padding: 14px at equal-or-lower specificity in its own\n       open-state rule — this must win so the list clears the ✕ button */\n    padding: 52px 14px 14px;\n    box-shadow: 0 18px 54px rgba(10, 8, 30, 0.22);\n    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);\n  }\n\n  .left-sidebar.swiping,\n  .left-sidebar.swiping.mobile-open {\n    transition: none;\n  }\n\n  .sidebar-close {\n    position: absolute;\n    top: 8px;\n    right: 8px;\n    color: #5a6b83;\n  }\n\n  /* labelled drawer: full-width rows with names instead of icon-only strips */\n  .brand {\n    justify-content: flex-start;\n  }\n\n  .brand > span:last-child {\n    display: inline;\n  }\n\n  .primary-nav {\n    align-items: stretch;\n  }\n\n  .nav-item {\n    width: 100%;\n    min-height: 46px;\n    justify-content: flex-start;\n    gap: 16px;\n    padding: 0 16px;\n    border-radius: 13px;\n  }\n\n  .nav-item span {\n    display: inline !important;\n    font-size: 14.5px;\n    font-weight: 600;\n    letter-spacing: -0.1px;\n    white-space: nowrap;\n  }\n\n  .compose-sidebar {\n    width: 100%;\n    min-height: 46px;\n    margin: 15px 0;\n    padding: 0 16px;\n    justify-content: flex-start;\n    gap: 12px;\n    font-size: 14.5px;\n    font-weight: 700;\n  }\n\n  .sidebar-bottom .profile-chip,\n  .profile-chip {\n    width: 100%;\n    justify-content: flex-start;\n    padding: 8px 10px;\n  }\n\n  .profile-chip-copy {\n    display: flex !important;\n    flex-direction: column;\n    gap: 1px;\n  }\n\n  .profile-chip-copy small {\n    display: block;\n  }\n\n  .sidebar-bottom .profile-chip > svg:last-child {\n    display: inline !important;\n    margin-left: auto;\n  }\n\n  /* these live on the persistent mobile chrome (bottom nav + header) —\n     don't repeat them inside the drawer */\n  .nav-item.nav-on-main-ui {\n    display: none !important;\n  }\n\n  /* create is the bottom-nav \"+\" button, and sign-out moves to the Profile\n     page when it's built — neither belongs in the mobile drawer */\n  .compose-sidebar,\n  .sidebar-bottom {\n    display: none !important;\n  }\n\n  .sidebar-scrim {\n    position: fixed;\n    inset: 0;\n    background: rgba(12, 9, 28, 0.42);\n    z-index: 37;\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 0.28s ease;\n  }\n\n  .sidebar-scrim.open {\n    opacity: 1;\n    pointer-events: auto;\n  }\n\n  /* page follow-the-finger dragging + slide-in transitions */\n  .main-column {\n    transition: transform 0.26s cubic-bezier(0.22, 0.61, 0.36, 1);\n    will-change: transform;\n  }\n\n  .main-column.swiping,\n  .main-column.swiping.page-anim {\n    transition: none;\n  }\n\n  .main-column.page-anim.from-right { animation: page-in-right 0.3s cubic-bezier(0.22, 0.61, 0.36, 1); }\n  .main-column.page-anim.from-left { animation: page-in-left 0.3s cubic-bezier(0.22, 0.61, 0.36, 1); }\n}\n\n@keyframes page-in-right {\n  from { transform: translateX(64px); opacity: 0.4; }\n  to { transform: none; opacity: 1; }\n}\n\n@keyframes page-in-left {\n  from { transform: translateX(-64px); opacity: 0.4; }\n  to { transform: none; opacity: 1; }\n}\n\n/* ---- Comments (feed light theme + Discover dark theme) ------------------------ */\n\n.comments-overlay { z-index: 40; }\n\n.comments-sheet {\n  padding: 12px 16px 16px;\n  display: flex;\n  flex-direction: column;\n  max-height: 78vh;\n}\n\n.comments-sheet .sheet-handle { margin: 0 auto 10px; }\n\n.comments-sheet .sheet-heading { margin: 0 0 10px; }\n\n.comments-sheet .sheet-heading h2 { font-size: 17px; letter-spacing: -0.2px; }\n\n.comments-sheet .eyebrow { font-size: 9.5px; letter-spacing: 1.6px; }\n\n.comments-list {\n  flex: 0 1 auto;\n  min-height: 0;\n  max-height: 46vh;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  padding: 2px 2px 8px;\n  scrollbar-width: thin;\n}\n\n.comments-status { margin: 10px 0; font-size: 13px; color: #5a6b83; }\n\n.comments-empty {\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 3px;\n  text-align: center;\n  padding: 26px 12px 20px;\n}\n\n.comments-empty svg { color: #b6a5f8; margin-bottom: 4px; }\n\n.comments-empty b { color: #1b3157; font-size: 14.5px; }\n.comments-empty span { color: #5a6b83; font-size: 13px; }\n\n.comments-error { margin: 8px 0; display: flex; flex-direction: column; gap: 8px; }\n.comments-error p { margin: 0; font-size: 13px; color: #a11427; }\n\n.comments-retry {\n  align-self: flex-start;\n  border: none;\n  border-radius: 999px;\n  padding: 7px 14px;\n  background: linear-gradient(100deg, #6654f5, #8b5cf6);\n  color: #fff;\n  font-size: 12.5px;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.comment-row { display: flex; gap: 10px; align-items: flex-start; }\n\n.comment-avatar {\n  flex: 0 0 auto;\n  width: 34px;\n  height: 34px;\n  border-radius: 50%;\n  background: linear-gradient(145deg, #8b6cff, #6654f5);\n  color: #fff;\n  font-size: 12px;\n  font-weight: 800;\n  display: grid;\n  place-items: center;\n  margin-top: 1px;\n}\n\n.comment-main { flex: 1 1 auto; min-width: 0; }\n\n.comment-head {\n  display: flex;\n  align-items: baseline;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.comment-head b { font-size: 12.5px; color: #1b3157; }\n\n.comment-head span { font-size: 11px; color: #5a6b83; }\n\n.comment-time { opacity: 0.8; }\n\n.comment-body {\n  display: inline-block;\n  background: #f5f3fc;\n  border-radius: 2px 15px 15px 15px;\n  padding: 8px 12px;\n  margin: 5px 0 2px;\n  font-size: 13.5px;\n  line-height: 1.5;\n  color: #2d4268;\n  overflow-wrap: anywhere;\n}\n\n.comment-own-actions { display: flex; gap: 12px; margin: 2px 0 0 2px; }\n\n.comment-own-actions button {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  background: transparent;\n  border: none;\n  padding: 2px 0;\n  font-size: 11.5px;\n  font-weight: 700;\n  color: #6553a8;\n  cursor: pointer;\n}\n\n.comment-own-actions button:hover { color: #4331c9; }\n\n.comment-own-actions button.armed { color: #a11427; }\n\n.comment-edit textarea {\n  width: 100%;\n  margin-top: 3px;\n  border: 1px solid #ddd8ef;\n  border-radius: 12px;\n  padding: 8px 10px;\n  font-size: 13px;\n  resize: none;\n}\n\n.comment-edit-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 6px; }\n\n.comment-mini {\n  border: none;\n  border-radius: 999px;\n  padding: 6px 13px;\n  font-size: 12px;\n  font-weight: 700;\n  background: #f1efff;\n  color: #4331c9;\n  cursor: pointer;\n}\n\n.comment-mini.primary { background: linear-gradient(100deg, #6654f5, #8b5cf6); color: #fff; }\n.comment-mini:disabled { opacity: 0.6; cursor: default; }\n\n/* composer */\n.comment-composer {\n  display: flex;\n  align-items: flex-end;\n  gap: 9px;\n  border-top: 1px solid #efece2;\n  padding-top: 11px;\n  margin-top: 10px;\n}\n\n.comment-input {\n  flex: 1;\n  border: 1px solid #e3dded;\n  border-radius: 20px;\n  padding: 10px 14px;\n  font-size: 13.5px;\n  resize: none;\n  max-height: 96px;\n  background: #fbfaff;\n  line-height: 1.45;\n}\n\n.comment-input:focus {\n  outline: none;\n  border-color: #9e8cf8;\n  box-shadow: 0 0 0 3px rgba(102, 84, 245, 0.13);\n  background: #fff;\n}\n\n.comment-send {\n  flex: 0 0 auto;\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  border: none;\n  background: linear-gradient(100deg, #6654f5, #8b5cf6);\n  color: #fff;\n  display: grid;\n  place-items: center;\n  cursor: pointer;\n  box-shadow: 0 5px 14px rgba(102, 84, 245, 0.35);\n}\n\n.comment-send:disabled { opacity: 0.4; cursor: default; box-shadow: none; }\n\n.comment-counter {\n  text-align: right;\n  font-size: 10.5px;\n  color: #8a93a8;\n  margin-top: 5px;\n}\n\n/* ---- dark theme (Discover) ---- */\n\n.comments-sheet.dark {\n  background: #171226;\n  color: #fff;\n  box-shadow: 0 -18px 60px rgba(5, 3, 14, 0.7);\n}\n\n.comments-sheet.dark .sheet-handle { background: rgba(255, 255, 255, 0.22); }\n\n.comments-sheet.dark .eyebrow { color: #b3a7ff; }\n\n.comments-sheet.dark .icon-button { color: rgba(255, 255, 255, 0.75); }\n.comments-sheet.dark .icon-button:hover { color: #fff; }\n\n.comments-sheet.dark h2,\n.comments-sheet.dark .comments-empty b { color: #fff; }\n\n.comments-sheet.dark .comments-empty svg { color: #6d5af7; }\n\n.comments-sheet.dark .comments-empty span,\n.comments-sheet.dark .comments-status { color: rgba(255, 255, 255, 0.55); }\n\n.comments-sheet.dark .comments-error p { color: #ffb4c1; }\n\n.comments-sheet.dark .comment-avatar { box-shadow: 0 3px 10px rgba(8, 4, 24, 0.5); }\n\n.comments-sheet.dark .comment-head b { color: #fff; }\n\n.comments-sheet.dark .comment-head span { color: rgba(255, 255, 255, 0.55); }\n\n.comments-sheet.dark .comment-body {\n  background: rgba(255, 255, 255, 0.07);\n  color: rgba(255, 255, 255, 0.94);\n}\n\n.comments-sheet.dark .comment-own-actions button { color: #b3a7ff; }\n.comments-sheet.dark .comment-own-actions button:hover { color: #d6cdff; }\n.comments-sheet.dark .comment-own-actions button.armed { color: #ff90a8; }\n\n.comments-sheet.dark .comment-edit textarea {\n  background: rgba(255, 255, 255, 0.07);\n  border-color: rgba(255, 255, 255, 0.16);\n  color: #fff;\n}\n\n.comments-sheet.dark .comment-mini { background: rgba(255, 255, 255, 0.12); color: #fff; }\n\n.comments-sheet.dark .comment-composer { border-top-color: rgba(255, 255, 255, 0.1); }\n\n.comments-sheet.dark .comment-input {\n  background: rgba(255, 255, 255, 0.08);\n  border-color: rgba(255, 255, 255, 0.14);\n  color: #fff;\n}\n\n.comments-sheet.dark .comment-input:focus {\n  background: rgba(255, 255, 255, 0.1);\n  border-color: #9e8cf8;\n  box-shadow: 0 0 0 3px rgba(139, 124, 255, 0.18);\n}\n\n.comments-sheet.dark .comment-input::placeholder { color: rgba(255, 255, 255, 0.42); }\n\n.comments-sheet.dark .comment-counter { color: rgba(255, 255, 255, 0.45); }\n\n@media (max-width: 650px) {\n  /* dvh: the comments input pulls up the mobile keyboard frequently */\n  .comments-sheet { max-height: 74vh; max-height: 74dvh; }\n  .comments-list { max-height: 40vh; max-height: 40dvh; }\n}\n\n/* ---- Discover: Reels feed ---------------------------------------------------- */\n\n.reels-stage {\n  position: sticky;\n  top: 0;\n  height: 100vh;\n  overflow-y: auto;\n  overflow-x: hidden;\n  scroll-snap-type: y mandatory;\n  background: #0b0817;\n  scrollbar-width: none;\n  z-index: 2;\n}\n\n.reels-stage::-webkit-scrollbar { display: none; }\n\n.reel-slide {\n  position: relative;\n  scroll-snap-align: start;\n  scroll-snap-stop: always;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: #0b0817;\n}\n\n.reel-frame {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  background: #12101f;\n  /* double-tap-to-like must never paint a text selection or a tap flash */\n  user-select: none;\n  -webkit-user-select: none;\n  -webkit-tap-highlight-color: transparent;\n}\n\n.reel-slide-video {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n  cursor: pointer;\n}\n\n.reel-video-missing {\n  width: 100%;\n  height: 100%;\n  display: grid;\n  place-items: center;\n  color: rgba(255, 255, 255, 0.6);\n  font-size: 14px;\n  cursor: default;\n}\n\n.reel-shade {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  height: 40%;\n  background: linear-gradient(180deg, rgba(11, 8, 23, 0) 0%, rgba(11, 8, 23, 0.62) 70%, rgba(11, 8, 23, 0.8) 100%);\n  pointer-events: none;\n}\n\n.reel-shade.top {\n  top: 0;\n  bottom: auto;\n  height: 90px;\n  background: linear-gradient(180deg, rgba(11, 8, 23, 0.55) 0%, rgba(11, 8, 23, 0) 100%);\n}\n\n.reel-big-play {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  width: 72px;\n  height: 72px;\n  border-radius: 50%;\n  background: rgba(102, 84, 245, 0.85);\n  color: #fff;\n  display: grid;\n  place-items: center;\n  padding-left: 5px;\n  box-shadow: 0 14px 40px rgba(12, 6, 40, 0.5), 0 0 0 6px rgba(102, 84, 245, 0.16);\n  pointer-events: none;\n  z-index: 3;\n  animation: reel-pop 0.18s ease;\n}\n\n.reel-heart-burst {\n  position: absolute;\n  transform: translate(-50%, -50%);\n  color: #ff4d79;\n  pointer-events: none;\n  z-index: 7;\n  filter: drop-shadow(0 6px 18px rgba(255, 60, 110, 0.45));\n  animation: reel-heart 0.8s ease forwards;\n}\n\n@keyframes reel-heart {\n  0% { transform: translate(-50%, -50%) scale(0.3); opacity: 0.95; }\n  30% { transform: translate(-50%, -50%) scale(1.15); opacity: 1; }\n  55% { transform: translate(-50%, -50%) scale(1); }\n  100% { transform: translate(-50%, -62%) scale(1.35); opacity: 0; }\n}\n\n.reel-top {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 12px 14px;\n  z-index: 4;\n}\n\n.reel-mute {\n  width: 38px;\n  height: 38px;\n  border-radius: 50%;\n  border: none;\n  background: rgba(20, 16, 40, 0.45);\n  backdrop-filter: blur(8px);\n  color: #fff;\n  display: grid;\n  place-items: center;\n  cursor: pointer;\n}\n\n.reel-mute:hover { background: rgba(20, 16, 40, 0.65); }\n\n.reel-rail {\n  position: absolute;\n  right: 10px;\n  bottom: 30px;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n  align-items: center;\n  z-index: 5;\n}\n\n.reel-rail-item {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 4px;\n  color: #fff;\n  font-size: 11.5px;\n  font-weight: 600;\n  font-variant-numeric: tabular-nums;\n}\n\n.reel-rail-item button {\n  width: 46px;\n  height: 46px;\n  border-radius: 50%;\n  border: none;\n  background: rgba(20, 16, 40, 0.42);\n  backdrop-filter: blur(8px);\n  color: #fff;\n  display: grid;\n  place-items: center;\n  cursor: pointer;\n  transition: background 0.15s ease, transform 0.12s ease;\n}\n\n.reel-rail-item button:active { transform: scale(0.92); }\n.reel-rail-item button:hover { background: rgba(20, 16, 40, 0.62); }\n\n.reel-rail-item button.liked {\n  color: #ff4d79;\n  background: rgba(255, 77, 121, 0.16);\n}\n\n.reel-rail-item button.saved {\n  color: #f7c948;\n  background: rgba(247, 201, 72, 0.16);\n}\n\n.reel-more-pop {\n  position: absolute;\n  right: 64px;\n  bottom: 34px;\n  background: #fff;\n  border-radius: 14px;\n  padding: 8px;\n  min-width: 185px;\n  box-shadow: 0 16px 44px rgba(12, 8, 40, 0.35);\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  z-index: 8;\n}\n\n.reel-more-pop button {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  background: transparent;\n  border: none;\n  border-radius: 10px;\n  padding: 10px 12px;\n  font-size: 13px;\n  font-weight: 600;\n  color: #29324f;\n  text-align: left;\n}\n\n.reel-more-pop button:hover { background: #f3f1ff; color: #4331c9; }\n\n.reel-info {\n  position: absolute;\n  left: 14px;\n  right: 72px;\n  bottom: 28px;\n  display: flex;\n  gap: 10px;\n  align-items: flex-end;\n  z-index: 5;\n  color: #fff;\n}\n\n.reel-info-avatar {\n  flex: 0 0 auto;\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  background: linear-gradient(145deg, #8b6cff, #6654f5);\n  color: #fff;\n  font-size: 13.5px;\n  font-weight: 800;\n  display: grid;\n  place-items: center;\n  box-shadow: 0 4px 14px rgba(12, 8, 40, 0.4);\n}\n\n.reel-info-avatar.anonymous { background: linear-gradient(145deg, #d94ed0, #f34c8