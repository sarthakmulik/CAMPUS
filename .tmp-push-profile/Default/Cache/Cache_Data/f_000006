rid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 8px 18px; }\n.about-facts dt { font-size: 10.5px; text-transform: uppercase; letter-spacing: .6px; color: #8b97ad; font-weight: 700; }\n.about-facts dd { margin: 2px 0 0; font-size: 12.5px; color: #2c3a55; }\n.rules-list { margin: 0; padding-left: 20px; font-size: 13px; color: #4c5a75; line-height: 1.7; }\n.report-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }\n.report-list li { border: 1px solid #f3c8cd; background: #fdf1f2; border-radius: 12px; padding: 9px 12px; font-size: 12.5px; color: #6b2030; }\n.report-list b { display: block; margin-bottom: 2px; }\n.report-list p { margin: 0 0 3px; font-size: 12px; }\n.report-list span { font-size: 11px; color: #a05a67; }\n.about-footnote { margin: 0; font-size: 11.5px; color: #8b97ad; line-height: 1.6; }\n.capitalize { text-transform: capitalize; }\n\n/* ---- Responsive ------------------------------------------------------------- */\n@media(max-width:650px){\n  .communities-page, .community-detail { padding-left: 13px; padding-right: 13px; }\n  .communities-head { flex-direction: column; }\n  .community-grid { grid-template-columns: 1fr; }\n  .event-grid { grid-template-columns: 1fr; }\n  .member-since { display: none; }\n  /* Mobile Chat tab = a full-bleed chat screen. The detail root becomes a\n     height-100% flex column (same sizing mechanic as the DM chats page), so\n     the composer mathematically sits ABOVE the fixed bottom nav — independent\n     of header height, scroll position or keyboard (shell is 100dvh, so the\n     flex remainder shrinks with the keyboard). The desktop card skin (border,\n     radius, fixed height) is dropped: the conversation reads edge-to-edge\n     like the DM thread screen, and its own inner scroller keeps the tab\n     chrome (topbar + tabs) stationary. */\n  .chat-open.community-detail {\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    min-heig