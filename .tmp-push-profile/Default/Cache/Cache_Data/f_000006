t { margin-top: 8px; border: 1px solid #dde3ee; border-radius: 9px; padding: 6px 9px; font-size: 12.5px; width: 100%; }\n\n/* ---- Detail page -------------------------------------------------------- */\n.community-detail { max-width: 860px; margin: 0 auto; padding: 14px 18px 90px; }\n.detail-topbar { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; min-height: 34px; }\n.detail-topbar-title { display: flex; align-items: baseline; gap: 8px; min-width: 0; }\n.detail-topbar-title b { font-size: 16px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.detail-topbar-title span { display: inline-flex; align-items: center; gap: 3px; font-size: 11.5px; color: #7a87a3; text-transform: capitalize; flex: none; }\n.detail-loading-panel { display: flex; align-items: center; justify-content: center; gap: 9px; padding: 46px 0; color: #5a6b83; font-size: 13.5px; }\n.detail-loading-panel.small { padding: 20px 0; font-size: 12.5px; }\n\n/* Layout A — the full overview belongs to the About tab only. Slightly\n   restrained cover + identity row, membership actions right beneath. */\n.community-hero.about-hero { background: #fff; border: 1px solid #eef0f7; border-radius: 18px; overflow: hidden; padding: 0 0 6px; box-shadow: 0 4px 16px #23284d06; }\n.community-hero-cover { height: 130px; border-radius: 18px; overflow: hidden; background: #eef0f7; transition: height .2s cubic-bezier(.22,.61,.36,1); }\n.community-hero.about-hero .community-hero-cover { border-radius: 0; height: 118px; }\n.community-hero-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }\n.community-hero-cover-fallback { display: block; width: 100%; height: 100%; background: linear-gradient(135deg, #8c5bff55, #4f46e533); }\n.community-hero-bar { display: flex; align-items: center; gap: 14px; margin-top: -30px; padding: 0 16px; position: relative; }\n.community-hero-avatar { width: 64px; height: 64px; font-size: 21px; border-radius: 20px; border: 3px solid #fff; bo