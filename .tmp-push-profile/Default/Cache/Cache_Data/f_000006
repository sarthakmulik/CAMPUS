ne-height: 1.5; }\n.event-cancel-chip, .event-past-chip { border-radius: 999px; padding: 2px 8px; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .4px; text-decoration: none; }\n.event-cancel-chip { background: #fdeef0; color: #8f1d2c; }\n.event-past-chip { background: #eef0f7; color: #5a6b83; }\n.event-meta { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; color: #8b97ad; flex-wrap: wrap; }\n.event-rsvp { display: flex; gap: 8px; margin-top: 7px; }\n.rsvp-btn { border: 1px solid #d9def0; background: #fff; border-radius: 999px; padding: 5px 13px; font-size: 12px; font-weight: 700; color: #40506e; }\n.rsvp-btn.on { background: #14683f; border-color: #14683f; color: #fff; }\n.rsvp-btn:disabled { opacity: .55; cursor: not-allowed; }\n.event-org-tools { display: flex; flex-direction: column; gap: 4px; align-self: flex-start; }\n\n/* ---- Members --------------------------------------------------------------- */\n.member-toolbar { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; margin-bottom: 12px; }\n.member-toolbar .community-searchbar { flex: 1; min-width: 200px; }\n.invite-field { display: flex; gap: 6px; }\n.invite-field input { border: 1px solid #dde3ee; border-radius: 12px; padding: 7px 11px; font-size: 12.5px; width: 180px; outline: none; }\n.join-request-board { border: 1px solid #f0e2b6; background: #fdf8ec; border-radius: 15px; padding: 12px 14px; margin-bottom: 12px; display: flex; flex-direction: column; gap: 8px; }\n.join-request-board header { display: flex; align-items: center; justify-content: space-between; }\n.join-request-board h4 { margin: 0; font-size: 13px; color: #7a5b13; }\n.join-request-board .member-row { background: #fff; border-color: #f0e2b6; }\n.member-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }\n.member-row { display: flex; align-items: center; gap: 10px; border: 1px solid #e8eaf1; border-radius: 14px; background: #ff