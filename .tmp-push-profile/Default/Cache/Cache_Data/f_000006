he composer ready below */\n.cc-empty {\n  margin: auto 14px 18px;\n  display: flex; flex-direction: column; align-items: center; gap: 5px;\n  padding: 20px 14px; text-align: center;\n  border: 1px dashed #e2ddf4; border-radius: 15px; background: #fbfaff;\n  color: #5a6b83;\n}\n.cc-empty svg { color: #8d7cf2; }\n.cc-empty b { font-size: 13px; color: #1b3157; }\n.cc-empty span { font-size: 11.5px; line-height: 1.55; max-width: 32ch; }\n\n/* header strip */\n.cc-head {\n  flex: none; display: flex; align-items: center; gap: 8px;\n  padding: 8px 12px; border-bottom: 1px solid #f0eceb; background: #fffdfbf2;\n}\n.cc-head-btn {\n  display: inline-flex; align-items: center; gap: 6px; border: 1px solid #e8eaf1;\n  background: #fff; color: #4f5d75; border-radius: 999px; padding: 6px 11px;\n  font-size: 12px; font-weight: 600; cursor: pointer;\n}\n.cc-head-btn:hover { background: #f6f4fb; border-color: #cfc9ef; }\n.cc-head-btn:focus-visible { outline: 2px solid #8b6cff; outline-offset: 1px; }\n\n/* pinned banner */\n.cc-pins {\n  flex: none; display: flex; align-items: center; gap: 7px; padding: 7px 12px;\n  background: #fdf9ee; border-bottom: 1px solid #f1e7c8; color: #8a6d1f; min-width: 0;\n}\n.cc-pin {\n  display: flex; align-items: baseline; gap: 7px; min-width: 0; border: 0;\n  background: none; cursor: pointer; text-align: left; padding: 0; color: inherit;\n}\n.cc-pin b { font-size: 11.5px; white-space: nowrap; }\n.cc-pin i { font-style: normal; font-size: 11.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.cc-pin:hover i { text-decoration: underline; }\n.cc-pin-count { flex: none; font-size: 10.5px; font-weight: 700; opacity: 0.8; }\n\n/* search panel */\n.cc-search {\n  flex: none; display: flex; flex-direction: column; gap: 8px; padding: 9px 12px 10px;\n  border-bottom: 1px solid #f0eceb; background: #fbfaff; max-height: 300px; overflow: hidden;\n}\n.cc-search-inputs { display: flex; align-items: center; gap: 7px; }\n.cc-search-inputs input {\n  flex: 1; min-width: 0; height: 36px; border: 1px solid #e4e2ef; border-radius: 10px;\n  padding: 0 11px; font-size: 12.5px; background: #fff; color: #1b3157;\n}\n.cc-search-inputs input:first-child { flex: 0 0 84px; }\n.cc-search-inputs input:focus { outline: none; border-color: #b7adfa; }\n.cc-search-results { overflow-y: auto; display: flex; flex-direction: column; gap: 4px; }\n.cc-search-hit {\n  display: flex; align-items: center; gap: 9px; border: 1px solid #eef0f6; border-radius: 11px;\n  background: #fff; padding: 8px 10px; cursor: pointer; text-align: left; min-width: 0;\n}\n.cc-search-hit:hover { border-color: #cfc9ef; background: #faf9ff; }\n.cc-hit-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }\n.cc-hit-main b { font-size: 12px; color: #1b3157; }\n.cc-hit-main b i { font-weight: 500; font-style: normal; color: #8a94a6; font-size: 10.5px; }\n.cc-hit-main em { font-style: normal; font-size: 12px; color: #516078; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n/* day separators */\n.cc-day { display: flex; justify-content: center; margin: 10px 0 4px; }\n.cc-day span {\n  font-size: 10.5px; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase;\n  color: #8a94a6; background: #f4f4f8; border-radius: 999px; padding: 4px 12px;\n}\n\n/* load-older + jump-to-latest */\n.cc-load-older {\n  align-self: center; margin: 4px 0 2px; font-size: 11.5px; font-weight: 600; color: #6654f5;\n  display: inline-flex; align-items: center; gap: 6px;\n}\n.cc-jump {\n  position: absolute; right: 14px; bottom: 18px; z-index: 6;\n  display: inline-flex; align-items: center; gap: 5px; border: 1px solid #e8eaf1;\n  background: #fff; color: #4f5d75; border-radius: 999px; padding: 7px 11px; cursor: pointer;\n  box-shadow: 0 6px 18px rgba(31, 41, 55, 0.12); font-size: 12px; font-weight: 700;\n}\n.cc-jump i { font-style: normal; background: #6654f5; color: #fff; border-radius: 999px; padding: 0 6px; font-size: 10.5px; line-height: 18px; }\n.cc-jump:hover { border-color: #b7adfa; color: #6654f5; }\n\n/* grouped consecutive rows read tighter */\n.chat-bubble-row.grouped { margin-top: -2px; }\n/* the message menu (reused .chat-msg-menu rules) anchors to the row itself,\n   not to the panel — the DM page inherits a positioned pane, this panel's\n   nearest positioned ancestor is .cc-root */\n.cc-root .chat-bubble-row,\n.cc-thread .chat-bubble-row { position: relative; }\n.cc-root .chat-msg-menu,\n.cc-thread .chat-msg-menu { top: 100%; margin-top: 4px; left: auto; right: 6px; }\n.cc-thread .chat-msg-menu,\n.cc-root .chat-bubble-row:not(.mine) .chat-msg-menu { right: auto; left: 34px; }\n.cc-root .chat-bubble-row:not(.mine) .chat-msg-menu { left: 34px; }\n.chat-bubble-row.grouped .chat-sender { display: none; }\n.chat-bubble-row.flash .chat-bubble { animation: cc-flash 1.5s ease; }\n@keyframes cc-flash {\n  0%, 55% { box-shadow: 0 0 0 3px rgba(139, 108, 255, 0.45); }\n  100% { box-shadow: 0 0 0 0 rgba(139, 108, 255, 0); }\n}\n@media (prefers-reduced-motion: reduce) {\n  .chat-bubble-row.flash .chat-bubble { animation: none; outline: 2px solid #8b6cff; }\n}\n\n/* body, reply chips, attachments inside bubbles */\n.cc-body { margin: 0; }\n.chat-reply-chip {\n  display: flex; align-items: center; gap: 6px; width: 100%; border: 0; cursor: pointer;\n  background: rgba(255, 255, 255, 0.22); border-radius: 9px; padding: 4px 8px; margin-bottom: 5px;\n  text-align: left;\n}\n.chat-bubble.theirs .chat-reply-chip { background: rgba(102, 84, 245, 0.08); }\n.chat-reply-text { display: flex; flex-direction: column; min-width: 0; max-width: 100%; }\n.chat-reply-text b { font-size: 10.5px; font-weight: 700; white-space: nowrap; }\n.chat-reply-text i {\n  font-style: normal; font-size: 11px; opacity: 0.85;\n  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 240px;\n}\n.chat-reply-chip:hover { background: rgba(255, 255, 255, 0.34); }\n.chat-bubble.theirs .chat-reply-chip:hover { background: rgba(102, 84, 245, 0.14); }\n\n.chat-attachments { display: flex; flex-direction: column; gap: 6px; margin-top: 6px; }\n.chat-attachments.grid { display: grid; grid-template-columns: 1fr 1fr; }\n.chat-attachment-image {\n  border: 0; padding: 0; cursor: zoom-in; border-radius: 12px; overflow: hidden;\n  background: #ece9f3; min-height: 54px; display: flex; align-items: center; justify-content: center;\n}\n.chat-attachment-image img { display: block; width: 100%; max-height: 240px; object-fit: cover; }\n.chat-attachment-file {\n  display: flex; align-items: center; gap: 9px; text-decoration: none; color: inherit;\n  background: rgba(255, 255, 255, 0.24); border-radius: 11px; padding: 7px 10px;\n}\n.chat-bubble.theirs .chat-attachment-file { background: rgba(102, 84, 245, 0.09); }\n.chat-attachment-file:hover { background: rgba(255, 255, 255, 0.38); }\n.chat-attachment-file span { display: flex; flex-direction: column; min-width: 0; }\n.chat-attachment-file b { font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.chat-attachment-file i { font-style: normal; font-size: 10.5px; opacity: 0.8; }\n\n.chat-meta-row small { display: block; margin-top: 4px; font-size: 9.5px; opacity: 0.72; }\n\n/* reactions */\n.chat-reactions { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }\n.chat-reaction {\n  display: inline-flex; align-items: center; gap: 4px; border: 1px solid rgba(255,255,255,0.35);\n  background: rgba(255,255,255,0.22); border-radius: 999px; padding: 2px 8px; cursor: pointer;\n  font-size: 12px; line-height: 18px;\n}\n.chat-bubble.theirs .chat-reaction { border-color: #e4e2ef; background: #fff; }\n.chat-reaction i { font-style: normal; font-size: 10.5px; font-weight: 700; color: #fff; opacity: 0.9; }\n.chat-bubble.theirs .chat-reaction i { color: #516078; }\n.chat-reaction.mine { border-color: #fff; background: rgba(255,255,255,0.42); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.6); }\n.chat-bubble.theirs .chat-reaction.mine { border-color: #8b6cff; background: #f1edff; box-shadow: none; }\n\n.cc-reaction-picker {\n  position: absolute; bottom: calc(100% + 6px); right: 8px; z-index: 32;\n  display: flex; gap: 2px; background: #fff; border: 1px solid #ece9f3; border-radius: 999px;\n  box-shadow: 0 10px 26px rgba(31, 41, 55, 0.16); padding: 5px 7px;\n}\n.cc-reaction-picker button {\n  border: 0; background: none; font-size: 17px; line-height: 26px; width: 30px; height: 30px;\n  border-radius: 50%; cursor: pointer;\n}\n.cc-reaction-picker button:hover { background: #f6f4fb; }\n.chat-bubble-row:not(.mine) .cc-reaction-picker { left: 10px; right: auto; }\n\n/* hover-revealed action chips */\n.cc-actions { display: flex; align-items: center; gap: 3px; margin-top: 3px; flex-wrap: wrap; }\n.cc-chip {\n  display: inline-flex; align-items: center; gap: 3px; border: 0; cursor: pointer;\n  background: #f4f2f9; color: #7a8598; border-radius: 999px; padding: 4px 8px;\n  font-size: 11px; font-weight: 600;\n}\n.cc-chip:hover { background: #ece9f5; color: #4f5d75; }\n.cc-chip i { font-style: normal; font-size: 10px; font-weight: 700; }\n.cc-chip:focus-visible { outline: 2px solid #8b6cff; outline-offset: 1px; }\n@media (hover: hover) and (pointer: fine) {\n  .chat-bubble-row .cc-actions { visibility: hidden; opacity: 0; transition: opacity 0.12s ease; }\n  .chat-bubble-row:hover .cc-actions,\n  .chat-bubble-row:focus-within .cc-actions { visibility: visible; opacity: 1; }\n}\n\n/* composer */\n.chat-textarea {\n  flex: 1; min-width: 0; max-height: 120px; border: 1px solid #e4e2ef; border-radius: 18px;\n  padding: 10px 14px; background: #f7f6fc; color: #1b3157; font-size: 13px; font-family: inherit;\n  line-height: 1.45; resize: none; overflow-y: auto;\n}\n.chat-textarea:focus { outline: none; border-color: #b7adfa; background: #fff; }\n.chat-textarea:disabled { background: #f4f4f8; color: #9aa7ba; }\n.chat-attach {\n  width: 42px; height: 42px; flex: none; border: 1px solid #e4e2ef; border-radius: 50%;\n  background: #f7f6fc; color: #516078; display: inline-flex; align-items: center; justify-content: center;\n  cursor: pointer;\n}\n.chat-attach:hover { background: #ece9f5; color: #6654f5; }\n.chat-attach:disabled { opacity: 0.45; cursor: not-allowed; }\n.cc-limit { text-align: right; font-size: 10px; color: #8a94a6; padding: 0 16px 4px; }\n.chat-input-wrap { position: relative; display: flex; flex-direction: column; }\n\n/* reply / edit banners + pending attachments */\n.cc-context-banner {\n  display: flex; align-items: center; gap: 9px; margin: 8px 12px 0; padding: 7px 11px;\n  background: #f4f2fb; border: 1px solid #e4ddf6; border-radius: 11px; color: #4f46a5;\n}\n.cc-context-banner svg { flex: none; }\n.cc-context-banner > div { min-width: 0; flex: 1; display: flex; flex-direction: column; }\n.cc-context-banner b { font-size: 11.5px; }\n.cc-context-banner i { font-style: normal; font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.cc-context-banner button { flex: none; border: 0; background: none; color: #7a6ad8; cursor: pointer; padding: 3px; border-radius: 7px; }\n.cc-context-banner button:hover { background: #e7e2f6; }\n.cc-pending { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 12px 0; }\n.cc-pending-chip {\n  display: inline-flex; align-items: center; gap: 5px; background: #f4f2f9;\n  border: 1px solid #e4e2ef; border-radius: 999px; padding: 4px 6px 4px 9px; font-size: 11px; color: #4f5d75;\n}\n.cc-pending-chip i { font-style: normal; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.cc-pending-chip button { border: 0; background: #e6e2f2; color: #516078; border-radius: 50%; width: 18px; height: 18px;\n  display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }\n.cc-pending-chip button:hover { background: #d9d3ee; }\n\n/* mention autocomplete */\n.cc-mentions {\n  position: absolute; left: 12px; right: 12px; bottom: calc(100% - 4px); z-index: 34;\n  background: #fff; border: 1px solid #ece9f3; border-radius: 13px;\n  box-shadow: 0 12px 30px rgba(31, 41, 55, 0.16); overflow: hidden;\n  display: flex; flex-direction: column;\n}\n.cc-mention-row {\n  display: flex; align-items: center; gap: 9px; border: 0; background: none; cursor: pointer;\n  padding: 7px 11px; text-align: left;\n}\n.cc-mention-row.on, .cc-mention-row:hover { background: #f6f4fb; }\n.cc-mention-name { display: flex; align-items: baseline; gap: 7px; min-width: 0; }\n.cc-mention-name b { font-size: 12.5px; color: #1b3157; }\n.cc-mention-name i { font-style: normal; font-size: 11px; color: #8a94a6; }\n\n/* thread overlay (same slide-in mechanic as the DM thread pane) */\n.cc-thread {\n  position: absolute; inset: 0; z-index: 8; background: #fffdfb; display: flex; flex-direction: column;\n  animation: cc-thread-in 0.22s cubic-bezier(0.22, 0.61, 0.36, 1);\n}\n@keyframes cc-thread-in { from { transform: translateX(14px); opacity: 0.4; } to { transform: none; opacity: 1; } }\n@media (prefers-reduced-motion: reduce) { .cc-thread { animation: none; } }\n.cc-thread-head {\n  flex: none; display: flex; align-items: center; gap: 9px; padding: 10px 14px;\n  border-bottom: 1px solid #f0eceb; background: #fffdfbf2;\n}\n.cc-thread-head button { border: 0; background: none; color: #516078; cursor: pointer; padding: 4px; border-radius: 8px; display: inline-flex; }\n.cc-thread-head button:hover { background: #f4f2f9; }\n.cc-thread-head b { font-size: 13px; color: #1b3157; }\n.cc-thread-head i { font-style: normal; font-size: 11.5px; color: #8a94a6; }\n.cc-thread-scroll { flex: 1; padding-top: 12px; }\n.cc-thread-hint {\n  flex: none; padding: 7px 14px calc(7px + env(safe-area-inset-bottom) * 0); font-size: 10.5px;\n  color: #8a94a6; border-top: 1px solid #f0eceb; background: #fffdfb;\n}\n\n/* image overlay */\n.cc-image-overlay {\n  position: fixed; inset: 0; z-index: 62; background: rgba(18, 20, 34, 0.86);\n  display: flex; align-items: center; justify-content: center; padding: 22px;\n}\n.cc-image-overlay img { max-width: 100%; max-height: calc(100vh - 130px); border-radius: 12px; }\n.cc-image-caption {\n  position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 12px;\n  padding: 12px 16px; background: rgba(14, 16, 28, 0.72); color: #e8eaf6; font-size: 12px;\n}\n.cc-image-caption span { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.cc-image-caption a { color: #cfc6ff; text-decoration: underline; }\n.cc-image-caption button { border: 0; background: rgba(255, 255, 255, 0.14); color: #fff; border-radius: 50%;\n  width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }\n.cc-image-caption button:hover { background: rgba(255, 255, 255, 0.24); }\n\n/* mobile */\n@media (max-width: 650px) {\n  .cc-head { padding: 6px 10px; }\n  .cc-jump { right: 10px; bottom: 18px; }\n  .cc-pins { padding: 6px 10px; }\n  .cc-search { padding: 6px 10px 8px; max-height: 260px; }\n  .cc-day { margin: 8px 0 2px; }\n  .chat-bubble-row { max-width: 92%; }\n  .cc-thread-hint { display: none; }\n  .cc-context-banner { margin-left: 10px; margin-right: 10px; }\n  .cc-pending { margin-left: 10px; margin-right: 10px; }\n  .chat-attachment-image img { max-height: 170px; }\n  .cc-image-overlay { align-items: flex-end; padding: 12px; }\n  .cc-image-overlay img { max-height: calc(100vh - 200px); border-radius: 10px; margin-bottom: 74px; }\n  .cc-image-caption { padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); }\n  .cc-reaction-picker { bottom: calc(100% + 4px); padding: 4px 5px; }\n}\n\n/* ===========================================================================\n   DIRECT MESSAGING 2.0 (dm-*) — shared CAMPUS content cards, inbox filters,\n   global/thread search, attachments (media/docs/voice), receipts, typing,\n   group details, forward + share sheets. Reuses the .chat-* bubble language,\n   .mini-spinner, .link-button, .avatar, .overlay and .wizard-actions inline.\n   =========================================================================== */\n\n/* ---- inbox: filters, inline search, row menus ---------------------------- */\n\n.chats-filters {\n  display: flex; align-items: center; gap: 6px; flex-wrap: wrap;\n  padding: 4px 15px 10px;\n}\n.chats-filter-chip {\n  border: 1px solid #e8eaf1; background: #fff; color: #55637c; border-radius: 999px;\n  padding: 5px 11px; font-size: 11.5px; font-weight: 700; cursor: pointer;\n}\n.chats-filter-chip.active { background: linear-gradient(120deg, #6654f5, #8b6cff); border-color: transparent; color: #fff; }\n.chats-filter-input {\n  flex: 1; min-width: 110px; height: 30px; border: 1px solid #ece8f5; border-radius: 8px;\n  padding: 0 10px; font-size: 12px; background: #faf9fd; color: #1b3157;\n}\n.chats-filter-input:focus { outline: none; border-color: #b7adfa; background: #fff; }\n\n.chats-hint.ok { color: #1f7a4d; background: #effaf3; border-color: #d3eed9; }\n\n.chats-global-search {\n  display: flex; align-items: center; gap: 7px; margin: 0 15px 8px;\n  border: 1px solid #ece8f5; border-radius: 11px; background: #faf9fd; padding: 0 10px;\n}\n.chats-global-search svg { color: #9aa2b8; flex: none; }\n.chats-global-search input {\n  flex: 1; min-width: 0; height: 36px; border: 0; background: none;\n  font-size: 12.5px; color: #1b3157;\n}\n.chats-global-search input:focus { outline: none; }\n.chats-global-results {\n  margin: 0 12px 10px; max-height: 300px; overflow-y: auto;\n  display: flex; flex-direction: column; gap: 3px;\n}\n.chats-global-hit {\n  display: grid; grid-template-columns: 26px minmax(0, 1fr) auto; align-items: center;\n  gap: 8px; border: 1px solid #f0eef8; background: #fff; border-radius: 11px;\n  padding: 7px 9px; cursor: pointer; text-align: left;\n}\n.chats-global-hit:hover { border-color: #cfc9ef; background: #faf9fd; }\n.chats-global-hit-copy { min-width: 0; display: flex; flex-direction: column; gap: 1px; }\n.chats-global-hit-copy b { font-size: 12px; color: #22335a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.chats-global-hit-copy small { font-size: 11px; color: #6d7a90; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.chats-global-hit > small { font-size: 10px; color: #9aa2b8; flex: none; }\n\n.chat-row-wrap { position: relative; }\n.chat-row-menu {\n  position: absolute; right: 9px; top: 50%; transform: translateY(-50%);\n  width: 26px; height: 26px; border: 0; border-radius: 50%;\n  background: transparent; color: #9aa2b8; display: inline-flex; align-items: center;\n  justify-content: center; cursor: pointer; z-index: 2;\n}\n.chat-row-menu:hover { background: #f1eefb; color: #4f5d75; }\n.dm-list-menu { top: auto; bottom: -4px; right: 34px; left: auto; min-width: 150px; }\n.dm-row-flag { font-style: normal; font-size: 10px; margin-left: 4px; color: #7a6ad8; }\n.dm-row-muted { margin-left: 4px; color: #9aa2b8; }\n\n/* ---- thread: header, search bar, load-older, receipts -------------------- */\n\n.chat-sub {\n  display: inline-flex; align-items: center; gap: 5px;\n  font-size: 10.5px; color: #8a94a6;\n}\n.dm-online-dot {\n  width: 7px; height: 7px; border-radius: 50%; background: #22c55e;\n  display: inline-block; box-shadow: 0 0 0 2px #ffffffcc;\n}\n\n.chat-search-bar {\n  display: flex; align-items: center; gap: 7px; padding: 7px 12px;\n  border-bottom: 1px solid #f0eceb; background: #faf9fd;\n}\n.chat-search-bar input {\n  flex: 1; min-width: 0; height: 34px; border: 1px solid #ece8f5; border-radius: 9px;\n  padding: 0 11px; font-size: 12.5px; background: #fff; color: #1b3157;\n}\n.chat-search-bar input:focus { outline: none; border-color: #b7adfa; }\n.chat-search-results {\n  max-height: 240px; overflow-y: auto; border-bottom: 1px solid #f0eceb;\n  background: #faf9fd; padding: 5px 8px; display: flex; flex-direction: column; gap: 3px;\n}\n.chat-search-hit {\n  display: grid; grid-template-columns: 24px minmax(0, 1fr) auto; align-items: center;\n  gap: 7px; border: 0; border-radius: 9px; background: none; padding: 6px 7px;\n  cursor: pointer; text-align: left;\n}\n.chat-search-hit:hover { background: #f1eefb; }\n.chat-search-hit-copy { min-width: 0; display: flex; flex-direction: column; gap: 1px; }\n.chat-search-hit-copy b { font-size: 11.5px; color: #22335a; }\n.chat-search-hit-copy small { font-size: 11px; color: #6d7a90; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.chat-search-hit > small { font-size: 10px; color: #9aa2b8; }\n\n.chat-load-older {\n  align-self: center; display: inline-flex; align-items: center; gap: 6px;\n  border: 1px solid #e8eaf1; background: #fff; color: #55637c; border-radius: 999px;\n  padding: 5px 12px; font-size: 11.5px; font-weight: 700; cursor: pointer; margin-bottom: 6px;\n}\n.chat-load-older:hover { border-color: #cfc9ef; background: #faf9fd; }\n\n.chat-system-row {\n  align-self: center; max-width: 78%; text-align: center;\n  background: #f4f4f8; color: #5a6b83; border-radius: 10px;\n  padding: 5px 11px; font-size: 11px;\n}\n.chat-system-row small { display: block; font-size: 9px; color: #9aa2b8; margin-top: 1px; }\n\n.chat-receipt { align-self: flex-end; padding-right: 4px; margin-top: -2px; }\n.chat-receipt small { font-size: 9.5px; color: #8a94a6; }\n\n.chat-bubble-row.highlighted .chat-bubble { box-shadow: 0 0 0 2px #f5b933; }\n\n/* ---- bubbles: quotes, attachments, voice, shared cards -------------------- */\n\n.chat-quote {\n  display: flex; flex-direction: column; gap: 1px; text-align: left;\n  border: 0; border-left: 3px solid #b7adfa; border-radius: 8px;\n  background: #f6f4fb; padding: 5px 9px; margin-bottom: 4px; cursor: pointer; max-width: 100%;\n}\n.chat-bubble.mine .chat-quote { background: rgba(255, 255, 255, 0.16); border-left-color: rgba(255, 255, 255, 0.6); }\n.chat-quote b { font-size: 10.5px; color: #5a3fe0; }\n.chat-bubble.mine .chat-quote b { color: #fff; }\n.chat-quote small { font-size: 11px; color: #55637c; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.chat-bubble.mine .chat-quote small { color: #ece9ff; }\n.chat-quote:hover { filter: brightness(0.98); }\n\n.chat-bubble.media-bubble { padding: 6px 7px 7px; }\n.chat-bubble.media-bubble p { padding: 2px 6px 0; }\n.chat-bubble.media-bubble small { padding: 0 6px; }\n\n.chat-att-grid { display: grid; gap: 3px; max-width: 230px; }\n.chat-att-grid.count-2 { grid-template-columns: 1fr 1fr; }\n.chat-att-grid.count-3, .chat-att-grid.count-4 { grid-template-columns: 1fr 1fr; }\n.chat-att-cell {\n  position: relative; display: flex; align-items: center; justify-content: center;\n  border-radius: 10px; overflow: hidden; background: #efeef6; min-height: 60px;\n}\n.chat-att-cell.image img { display: block; max-width: 230px; max-height: 260px; object-fit: cover; width: 100%; height: auto; }\n.chat-att-cell.loading { min-height: 80px; min-width: 80px; }\n.chat-att-cell.missing { font-size: 10.5px; color: #8a94a6; padding: 14px; }\n\n.chat-att-video { display: block; border-radius: 10px; max-width: 240px; max-height: 300px; background: #14182a; }\n.chat-att-video.loading, .chat-att-video.missing { display: flex; align-items: center; justify-content: center; min-width: 120px; min-height: 90px; color: #8a94a6; font-size: 11px; }\n\n/* voice notes — the bar is a real seek control now: waveform bars when the\n   clip was decoded, a simple progress track as the honest fallback */\n.chat-voice {\n  display: flex; align-items: center; gap: 7px; min-width: 150px;\n  padding: 4px 6px;\n}\n.chat-voice.failed { font-size: 11px; color: #b3265a; display: flex; align-items: center; gap: 8px; }\n.chat-voice-btn {\n  width: 30px; height: 30px; flex: none; border: 0; border-radius: 50%;\n  background: rgba(255, 255, 255, 0.22); color: #fff;\n  display: inline-flex; align-items: center; justify-content: center; cursor: pointer;\n}\n.chat-bubble.theirs .chat-voice-btn { background: #e5e0f7; color: #5a3fe0; }\n.chat-voice-bar {\n  flex: 1; min-width: 70px; height: 26px; display: flex; align-items: center; gap: 2px;\n  border: 0; background: transparent; padding: 0; cursor: pointer;\n}\n/* progress-track fallback (metadata undecodable) */\n.chat-voice-track {\n  display: block; position: relative; width: 100%; height: 5px;\n  border-radius: 4px; background: rgba(255, 255, 255, 0.28); overflow: hidden;\n}\n.chat-voice-track i { display: block; height: 100%; width: 0; background: #fff; border-radius: 4px; transition: width 0.2s ease; }\n/* waveform bars */\n.chat-voice-bar > i {\n  flex: none; width: 3px; border-radius: 2px;\n  background: rgba(255, 255, 255, 0.4); transition: background 0.15s ease;\n}\n.chat-voice-bar > i.on { background: #fff; }\n/* light surfaces: the preview panel and the peers' bubbles */\n.chat-voice-preview .chat-voice-track, .chat-bubble.theirs .chat-voice-track { background: #e7e4f2; }\n.chat-voice-preview .chat-voice-track i, .chat-bubble.theirs .chat-voice-track i { background: #7a6ad8; }\n.chat-voice-preview .chat-voice-bar > i, .chat-bubble.theirs .chat-voice-bar > i { background: #ddd8f0; }\n.chat-voice-preview .chat-voice-bar > i.on, .chat-bubble.theirs .chat-voice-bar > i.on { background: #7a6ad8; }\n.chat-voice small { flex: none; font-size: 9px; opacity: 0.85; font-variant-numeric: tabular-nums; }\n\n/* documents */\n.chat-att-file {\n  display: flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.16);\n  border-radius: 10px; padding: 7px 9px; margin: 2px 0 4px; max-width: 240px;\n}\n.chat-bubble.theirs .chat-att-file { background: #f1eefb; }\n.chat-att-file-copy { min-width: 0; display: flex; flex-direction: column; gap: 1px; }\n.chat-att-file-copy b { font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.chat-att-file-copy small { font-size: 9.5px; opacity: 0.8; }\n.chat-att-file a { color: inherit; display: inline-flex; padding: 3px; border-radius: 7px; }\n.chat-att-file a:hover { background: rgba(255, 255, 255, 0.2); }\n.chat-bubble.theirs .chat-att-file a:hover { background: #ece8f9; }\n\n/* shared CAMPUS content reference card — styled like a message, not a tile */\n.dm-share-card {\n  display: grid; grid-template-columns: 54px minmax(0, 1fr); align-items: center;\n  gap: 9px; width: 100%; border: 1px solid #ece8f5; border-radius: 12px;\n  background: #fff; padding: 5px; margin-bottom: 6px; cursor: pointer; text-align: left;\n  max-width: 240px;\n}\n.dm-share-card:hover { border-color: #cfc9ef; }\n.dm-share-card.unavailable {\n  display: block; background: #fdf3f6; border-color: #f3d8e1; color: #8a4a63;\n  max-width: none; padding: 10px 12px; cursor: default;\n}\n.dm-share-card.unavailable b { display: block; font-size: 12px; }\n.dm-share-card.unavailable small { font-size: 10.5px; }\n.dm-share-media {\n  position: relative; width: 54px; height: 54px; border-radius: 9px; overflow: hidden;\n  background: #f2f1f8; display: block;\n}\n.dm-share-media img, .dm-share-media video { width: 100%; height: 100%; object-fit: cover; display: block; }\n.dm-share-play {\n  position: absolute; inset: 0; display: inline-flex; align-items: center; justify-content: center;\n  color: #fff; background: rgba(20, 24, 42, 0.28); border-radius: 0;\n}\n.dm-share-avatar {\n  width: 44px; height: 44px; border-radius: 50%; margin: 5px;\n  display: inline-flex; align-items: center; justify-content: center;\n  background: linear-gradient(145deg, #8b6cff, #6654f5); color: #fff; font-weight: 700; font-size: 15px;\n}\n.dm-share-fallback {\n  display: inline-flex; align-items: center; justify-content: center;\n  width: 100%; height: 100%; font-size: 18px; font-weight: 800; color: #b7adfa;\n}\n.dm-share-copy { display: flex; flex-direction: column; gap: 1px; min-width: 0; }\n.dm-share-copy b { font-size: 12px; color: #22335a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }\n.dm-share-copy small { font-size: 10.5px; color: #6d7a90; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n/* ---- reactions (DM) ------------------------------------------------------- */\n\n.chat-reaction-row { display: flex; flex-wrap: wrap; gap: 3px; padding: 2px 4px 0; }\n.chat-reaction-row button {\n  display: inline-flex; align-items: center; gap: 3px; border: 1px solid #ece8f5;\n  background: #fff; border-radius: 999px; padding: 2px 7px; cursor: pointer;\n}\n.chat-reaction-row button.mine { border-color: #b7adfa; background: #f3f0ff; }\n.chat-reaction-row button span { font-size: 12px; line-height: 1; }\n.chat-reaction-row button i { font-style: normal; font-size: 10px; color: #6d7a90; font-weight: 700; }\n.dm-reaction-picker { min-width: 232px; padding: 5px; flex-direction: row; gap: 2px; }\n.dm-reaction-picker button {\n  flex: 1; justify-content: center; font-size: 17px; padding: 5px 2px; border-radius: 9px;\n}\n\n/* ---- composer: attach menu, chips, reply context, voice -------------------- */\n\n.chat-compose {\n  flex: none; border-top: 1px solid #f0eceb; background: #fffdfb;\n  padding-bottom: calc(env(safe-area-inset-bottom) * 0.4);\n}\n/* on wide screens the conversation reads as a centered column instead of\n   stretching across the whole split — timeline, header and composer share\n   one width so the composer stays visually anchored under the messages */\n@media (min-width: 1100px) {\n  .chat-thread-head, .chat-scroll, .chat-compose {\n    max-width: 760px; width: 100%; margin-inline: auto;\n  }\n  .chat-thread-head { border-bottom: 1px solid #f0eceb; }\n  .chat-compose { border-top: 1px solid #f0eceb; }\n}\n.chat-toolbar-row {\n  display: flex; align-items: center; gap: 9px;\n  padding: 10px 14px 9px;\n}\n.chat-toolbar-row input {\n  flex: 1; min-width: 0; height: 42px; border: 1px solid #e4e2ef; border-radius: 21px;\n  padding: 0 16px; background: #f7f6fc; color: #1b3157; font-size: 13px;\n}\n.chat-toolbar-row input:focus { outline: none; border-color: #b7adfa; background: white; }\n.chat-toolbar-row input:disabled { opacity: 0.6; }\n.chat-tool { width: 38px; height: 38px; }\n.chat-attach-menu-root { position: relative; flex: none; }\n.dm-attach-menu { bottom: calc(100% + 6px); top: auto; left: 0; min-width: 168px; }\n\n/* mic + stop variants of the send button */\n.chat-send.mic { background: #ece9f8; color: #5a3fe0; box-shadow: none; }\n.chat-send.mic:hover { background: #e2ddf7; }\n.chat-send.stop { background: #e0356b; box-shadow: 0 4px 12px #e0356b40; }\n.icon-button.chat-tool.danger { background: #f7e8ee; color: #b3265a; }\n.icon-button.chat-tool.danger:hover { background: #f3d8e1; }\n.flex-spacer { flex: 1; }\n\n/* live recording strip: unmistakable pulse + elapsed, stop → preview */\n.chat-voice-rec {\n  flex: 1; min-width: 0; height: 42px; display: flex; align-items: center; gap: 9px;\n  border: 1px solid #f3d8e1; border-radius: 21px; background: #fdf5f8; padding: 0 6px 0 14px;\n}\n.chat-rec-dot {\n  width: 10px; height: 10px; border-radius: 50%; background: #e0356b; flex: none;\n  animation: chat-rec-pulse 1.2s ease-in-out infinite;\n}\n@keyframes chat-rec-pulse {\n  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(224, 53, 107, 0.25); }\n  50% { opacity: 0.55; box-shadow: 0 0 0 5px rgba(224, 53, 107, 0); }\n}\n.chat-rec-timer { font-size: 12px; font-weight: 800; color: #b3265a; flex: none; font-variant-numeric: tabular-nums; }\n.chat-voice-rec small { font-size: 10px; color: #b3265a; font-weight: 700; flex: none; }\n.chat-voice-rec .chat-send { width: 34px; height: 34px; }\n\n/* finished recording waiting in the composer — play it, keep it, send it */\n.chat-voice-preview {\n  flex: 1; min-width: 0; height: 42px; display: flex; align-items: center; gap: 7px;\n  border: 1px solid #e4e2ef; border-radius: 21px; background: #f7f6fc; padding: 0 6px;\n}\n.chat-voice-preview .chat-voice-btn {\n  width: 30px; height: 30px; border: 0; border-radius: 50%;\n  background: #e5e0f7; color: #5a3fe0; cursor: pointer;\n  display: inline-flex; align-items: center; justify-content: center;