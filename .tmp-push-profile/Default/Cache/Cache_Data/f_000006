  align-items: center;\n  gap: 7px;\n  padding: 22px 18px;\n  border: 1px dashed #ddd6f3;\n  border-radius: 16px;\n  background: #fbfaff;\n}\n.chats-list-pane { position: relative; }\n\n/* ---- tappable author identities (Instagram-style) ---------------------- */\n/* feed post header: avatar + name open the author's profile */\n.post-author-link {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  background: none;\n  border: 0;\n  padding: 0;\n  margin: 0;\n  text-align: left;\n  color: inherit;\n  cursor: pointer;\n  border-radius: 10px;\n}\n.post-author-link.static { cursor: default; }\n.post-author-link .post-avatar { display: flex; flex: none; }\n.post-author-link .post-id { flex: 1; }\n.post-author-link:not(.static):hover .post-namerow b { text-decoration: underline; }\n\n/* profile followers/following rows: the member opens their profile,\n   the Message button beside it stays separate */\n.search-row-link {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 11px;\n  background: none;\n  border: 0;\n  padding: 0;\n  margin: 0;\n  text-align: left;\n  color: inherit;\n  cursor: pointer;\n  border-radius: 10px;\n}\n.search-row-link .avatar { display: flex; flex: none; }\n.search-row-link:hover b { text-decoration: underline; }\n\n/* reel overlay: avatar + author name tap through to the profile */\n.reel-author-link {\n  background: none;\n  border: 0;\n  padding: 0;\n  margin: 0;\n  color: inherit;\n  font: inherit;\n  cursor: pointer;\n}\n.reel-author-link.reel-info-avatar { display: flex; align-items: center; justify-content: center; }\n.reel-author-link.reel-author-name { font-weight: 700; text-align: left; }\n.reel-author-link:hover { text-decoration: underline; }\n\n/* ---- Instagram message actions: hover ⋯, Edit / Unsend, tombstones ----- */\n.chat-bubble-row { position: relative; align-items: center; }\n.chat-msg-actions {\n  flex: none;\n  display: inline-flex;\n  visibility: hidden;\n  align-items: center;\n  justify-content: center;\n  width: 22px;\n  height: 22px;\n  border: 0;\n  border-radius: 50%;\n  background: #f4f2f9;\n  color: #7a8598;\n  padding: 0;\n  cursor: pointer;\n}\n.chat-bubble-row:hover .chat-msg-actions { visibility: visible; }\n@media (hover: none) { .chat-msg-actions { visibility: visible; opacity: .75; } }\n.chat-msg-actions:hover { background: #ece9f5; color: #4f5d75; }\n/* JS-anchored message menus: fixed to the viewport at open time — below the\n   ⋯ trigger by default, flipped above when the row sits near the bottom edge\n   and clamped so the popup can never leave the screen */\n.chat-msg-menu.anchored {\n  position: fixed;\n  top: auto; bottom: auto; right: auto;\n  margin-top: 0;\n  z-index: 60;\n  max-width: calc(100vw - 16px);\n}\n.chat-msg-menu {\n  position: absolute;\n  top: 100%;\n  margin-top: 2px;\n  z-index: 30;\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n  background: #fff;\n  border: 1px solid #ece9f3;\n  border-radius: 12px;\n  box-shadow: 0 10px 26px #2e355d18;\n  padding: 4px;\n  min-width: 118px;\n}\n.chat-bubble-row.mine .chat-msg-menu { left: 28px; }\n.chat-bubble-row:not(.mine) .chat-msg-menu { left: 44px; }\n.chat-msg-menu button {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  border: 0;\n  background: none;\n  border-radius: 9px;\n  padding: 7px 9px;\n  font-size: 12px;\n  color: #27354c;\n  cursor: pointer;\n  text-align: left;\n  white-space: nowrap;\n}\n.chat-msg-menu button:hover { background: #f6f4fb; }\n.chat-msg-menu button.danger { color: #c33a5e; }\n.chat-msg-menu button.danger:hover { background: #fdf1f4; }\n\n/* Unsent / moderator-removed rows read as one quiet system note, not a\n   message-sized card — the retraction event is kept in history, but it no\n   longer shouts from the wall the way a full bubble did. */\n.chat-bubble.unsent {\n  background: transparent !important;\n  border: 0;\n  box-shadow: none;\n  padding: 1px 3px;\n  color: #8a93ab;\n  font-style: italic;\n}\n.chat-bubble.unsent p { color: #8a93ab; font-size: 11px; padding: 0; }\n.chat-bubble.unsent small { display: none; }\n\n.chat-editing-hint {\n  position: absolute;\n  top: -21px;\n  left: 14px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 11px;\n  color: #6654f5;\n  background: #f5f3ff;\n  border-radius: 18px;\n  padding: 3px 10px;\n}\n.chat-editing-hint .link-button { font-size: 11px; }\n\n/* \"Who to follow\" rows: the member's identity opens their profile */\n.suggestion-link {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  background: none;\n  border: 0;\n  padding: 0;\n  margin: 0;\n  text-align: left;\n  color: inherit;\n  cursor: pointer;\n  border-radius: 10px;\n}\n.suggestion-link .avatar { display: flex; flex: none; }\n.suggestion-link:hover b { text-decoration: underline; }\n\n/* ==========================================================================\n   Communities (migration 0016) â€” discovery, detail, moderation UI\n   ========================================================================== */\n\n.communities-page { max-width: 860px; margin: 0 auto; padding: 20px 18px 80px; }\n.communities-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 14px; }\n.communities-head .page-title { font-size: 24px; letter-spacing: -0.6px; margin: 4px 0 2px; }\n.communities-head .page-subtitle { margin: 0; color: #5a6b83; font-size: 13px; max-width: 520px; }\n\n.community-searchbar { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 24px; background: #f4f4f8; color: #5a6b83; border: 1px solid transparent; }\n.community-searchbar:focus-within { border-color: #c9b8ff; background: #fff; }\n.community-searchbar input { flex: 1; border: 0; background: transparent; outline: none; font-size: 14px; color: #20304a; }\n.community-searchbar.small { padding: 7px 12px; border-radius: 18px; }\n\n.invite-strip { disp