12px; font-size: 13px; }\n.community-error p { margin: 0; }\n.community-error button { border: 0; background: #fff; border: 1px solid #f0b6bd; border-radius: 10px; padding: 6px 12px; color: #8f1d2c; font-weight: 600; display: inline-flex; gap: 6px; align-items: center; }\n\n.community-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; margin-top: 14px; }\n.community-card { border: 1px solid #e8eaf1; border-radius: 18px; background: #fff; overflow: hidden; display: flex; flex-direction: column; gap: 10px; padding-bottom: 14px; transition: box-shadow .18s; }\n.community-card:hover { box-shadow: 0 6px 22px #1f29371a; }\n.community-card-banner { border: 0; background: transparent; padding: 0; height: 92px; display: block; width: 100%; cursor: default; }\n.community-card-banner img { width: 100%; height: 92px; object-fit: cover; display: block; }\n.community-card-banner-fallback { display: block; width: 100%; height: 92px; }\n.community-card.row-banner .community-card-banner { cursor: pointer; }\n.community-card-row { display: flex; align-items: center; gap: 10px; padding: 0 14px; margin-top: -26px; position: relative; }\n.community-card-row .community-avatar { border: 3px solid #fff; box-shadow: 0 2px 8px #1f293722; }\n.community-avatar { width: 52px; height: 52px; display: inline-flex; align-items: center; justify-content: center; border-radius: 16px; background: linear-gradient(145deg,#8c5bff,#c144ed); color: #fff; font-weight: 800; font-size: 17px; overflow: hidden; flex: none; }\n.community-avatar img { width: 100%; height: 100%; object-fit: cover; }\n.community-card-title { border: 0; background: transparent; text-align: left; padding: 6px 0 0; display: flex; flex-direction: column; gap: 2px; }\n.community-card-title b { font-size: 15px; color: #111827; text-align: left; }\n.community-card-scope { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; color: #63708b; text-transform: uppercase; letter-spacin